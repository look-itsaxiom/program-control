{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(/api/internal/**)",
      "Edit(/api/migrations/**)",
      "Edit(/api/cmd/**)",
      "Edit(/api/phase_tests/**)",
      "Edit(/web/src/**)",
      "NotebookEdit",
      "Bash(git checkout solutions*)",
      "Bash(git switch solutions*)",
      "Bash(git show solutions*)",
      "Bash(git diff solutions*)",
      "Bash(git log solutions*)",
      "Bash(git merge solutions*)",
      "Bash(git cherry-pick solutions*)",
      "Bash(git restore --source solutions*)",
      "Bash(git worktree add * solutions*)"
    ],
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(pnpm check*)",
      "Bash(go test*)",
      "Bash(pnpm --filter web test*)",
      "Bash(node scripts/db.mjs*)"
    ]
  }
}
